# ===== 部署前复制为 .env 并按服务器实际情况修改 =====

# 数据(uploads/outputs/pg 数据库)的宿主路径。默认放部署目录 ./data 下。
# 服务器上建议放大盘,如 /data/flux
DATA_DIR=./data

# 对外端口 —— 服务器同时是 K8s worker,避开 80/443/30000-32767/10250 等 K8s 在用端口。
# 默认只绑本机或内网,外部访问建议用现有 Ingress/反代或 SSH 隧道。
FRONTEND_PORT=8080
BACKEND_PORT=127.0.0.1:8081   # 只绑回环,外网摸不到;调试时本机访问

# Postgres 账号(生产建议改强密码)
DB_USER=flux
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=flux

# --- Model API 地址 ---
# GPU 模型服务(model-api/app.py)由你单独部署在 GPU 服务器上,不在此 compose 中。
# 这里填它的可达地址,worker 和 backend 都靠它调推理/查进度。
MODEL_API_URL=http://<GPU服务器IP>:8000